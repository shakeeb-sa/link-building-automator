{
  "manifest_version": 3,
  "name": "⚡ Lightning LinkBuilder",
  "version": "10.0.1",
  "description": "Industrial-grade SEO link building automation – smart form filler, domain collision detector, and outreach tools.",
  "homepage_url": "https://linkflowpro.com",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lightning LinkBuilder"
  },
  "commands": {
    "fill-profile-1": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Fill with Profile 1"
    },
    "fill-profile-2": {
      "suggested_key": {
        "default": "Ctrl+Shift+2"
      },
      "description": "Fill with Profile 2"
    },
    "quad-fill": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Instant Autofill Entire Form"
    },
    "show-messages": {
      "suggested_key": {
        "default": "Ctrl+Shift+M"
      },
      "description": "Show Outreach Messages"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["<all_urls>"]
    }
  ]
}